# Environment of the API during `npm run e2e`. Committed: throwaway values for
# the ephemeral compose.test.yaml stack only. Loaded by scripts/e2e.sh
# (migrations) and playwright.config.ts (webServer). The port-dependent values
# (PORT, APP_URL, DB_PORT) are not here: scripts/e2e.sh exports them for the
# run's E2E slot.
NODE_ENV=test
TZ=UTC
HOST=127.0.0.1
LOG_LEVEL=warn
APP_KEY=e2e-key-not-real-0123456789abcdef
APP_NAME=monki-trips
REGISTRATION_OPEN=true
APP_DEFAULT_LOCALE=en
SESSION_DRIVER=cookie
DB_HOST=127.0.0.1
DB_USER=monkitrips
DB_PASSWORD=monkitrips
DB_DATABASE=monkitrips_e2e
DRIVE_DISK=fs
LLM_PROVIDER=fake
FX_PROVIDER=fake
WEATHER_PROVIDER=fake
FLIGHT_STATUS_PROVIDER=fake
MAIL_DRIVER=log
# Accounts the E2E suite signs in with. Synthetic, created by e2e/global-setup.ts
# through the production bootstrap seeder (verified, no trips) on the throwaway
# database of the run. Owner and partner share trips (J11); the solo traveller
# starts every run with an empty list (J01).
E2E_OWNER_EMAIL=owner@example.com
E2E_OWNER_PASSWORD=e2e-owner-password-1
E2E_PARTNER_EMAIL=partner@example.com
E2E_PARTNER_PASSWORD=e2e-partner-password-1
E2E_SOLO_EMAIL=solo@example.com
E2E_SOLO_PASSWORD=e2e-solo-password-1
