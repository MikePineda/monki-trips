# monki-trips self-host environment for compose.yaml. Copy it and fill it in:
#   cp .env.selfhost.example .env
# compose.yaml passes these to the app and derives the database's own
# settings from the DB_* values. See docs/SELF_HOSTING.md.

# Required. Generate once and keep it: `openssl rand -base64 32`.
# Changing it signs everyone out.
APP_KEY=
# The URL people open (behind your reverse proxy, e.g. https://trips.example.com).
APP_URL=http://localhost:3333
LOG_LEVEL=info
# true to create the first account, then set it to false and restart.
REGISTRATION_OPEN=true
# en | es: language when the browser asks for neither.
APP_DEFAULT_LOCALE=en
# Apply database migrations every time the app starts.
MIGRATE_ON_START=true

# Database (the `db` service of compose.yaml). Change the password before
# the first start: it becomes the Postgres password of the volume.
DB_HOST=db
DB_PORT=5432
DB_USER=monkitrips
DB_PASSWORD=change-me-before-first-start
DB_DATABASE=monkitrips

# Which proxy's client-address header to believe for throttles: none | cloudflare.
# Keep none unless the origin accepts traffic from Cloudflare alone.
TRUSTED_PROXY=none
