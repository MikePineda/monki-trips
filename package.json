{
  "name": "monki-trips",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "monki-trips: an offline-first travel PWA for people travelling together. AdonisJS 7 API + Angular 22 PWA monorepo.",
  "license": "AGPL-3.0-only",
  "workspaces": [
    "apps/*",
    "packages/*",
    "e2e"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "codegen": "turbo run codegen",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "turbo run e2e",
    "verify": "turbo run lint typecheck test build && npm run e2e",
    "verify:quick": "turbo run lint typecheck test build",
    "services:up": "docker compose -f compose.dev.yaml up -d --wait db",
    "services:down": "docker compose -f compose.dev.yaml down",
    "test:offline": "bash scripts/test-offline.sh",
    "test:guards": "bash scripts/ci/self-test.sh && node --test scripts/test/no-network.test.mjs",
    "check:lockfile": "node scripts/ci/check-lockfile.mjs",
    "privacy": "bash scripts/ci/privacy-pre-push.sh",
    "bruno:coverage": "node apps/api/scripts/bruno-coverage.mjs",
    "prepare": "node scripts/install-git-hooks.mjs"
  },
  "devDependencies": {
    "@adonisjs/prettier-config": "1.5.0",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "lefthook": "2.2.2",
    "prettier": "3.9.10",
    "turbo": "2.11.10"
  },
  "packageManager": "npm@11.19.0",
  "allowScripts": {
    "@parcel/watcher": true,
    "@swc/core": true,
    "esbuild": true,
    "fsevents": true,
    "lefthook": true,
    "lmdb": true,
    "msgpackr-extract": true
  },
  "prettier": "@adonisjs/prettier-config"
}
