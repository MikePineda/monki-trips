# Committed on purpose: test-only values, no real secrets. Loaded on top of
# `.env` when NODE_ENV=test (Japa). Without a `.env` (CI, a fresh clone) every
# required variable of start/env_schema.ts must have a value here.
NODE_ENV=test
TZ=UTC
HOST=127.0.0.1
PORT=3333
LOG_LEVEL=error
# Fixed, clearly fake key (not used anywhere else).
APP_KEY=test-key-not-real-0123456789abcdef
APP_URL=http://127.0.0.1:3333
APP_NAME=monki-trips
REGISTRATION_OPEN=true
APP_DEFAULT_LOCALE=en
TRUSTED_PROXY=none
SESSION_DRIVER=memory
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=monkitrips
DB_PASSWORD=monkitrips
DB_DATABASE=monkitrips_test
DRIVE_DISK=fs
LLM_PROVIDER=fake
LLM_API_KEY=
LLM_MODEL=
LLM_VISION_MODEL=
LLM_MONTHLY_TOKEN_CAP_OVERRIDE=
FX_PROVIDER=fake
WEATHER_PROVIDER=fake
FLIGHT_STATUS_PROVIDER=fake
MAIL_DRIVER=log
RESEND_API_KEY=
# Push stays disabled here: no private key is ever committed. The VAPID pair is
# generated at runtime by the specs that need them (tests/helpers/fake_push.ts).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
SCHEDULER=off
