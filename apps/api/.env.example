# monki-trips API environment. Copy to `.env` for local development:
#   cp apps/api/.env.example apps/api/.env && (cd apps/api && node ace generate:key)
# The values below work with the root compose.dev.yaml. Production values live
# only in the deployment's environment, never in the repo. Every variable is
# validated in start/env_schema.ts and a unit test keeps both files in sync.
# Empty optional values mean "off" or "use the default".

#--------------------------------------------------------------------
# Node / HTTP
#--------------------------------------------------------------------
# Process time zone. Keep UTC: local times are stored with their IANA zone.
TZ=UTC
# development | production | test
NODE_ENV=development
# Interface to bind. Inside a container: 0.0.0.0
HOST=localhost
# HTTP port (the image exposes 3333)
PORT=3333
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info

#--------------------------------------------------------------------
# App
#--------------------------------------------------------------------
# Encryption and cookie signing key. Generate with `node ace generate:key`
# (or `openssl rand -base64 32`). Rotating it ends every session.
APP_KEY=
# Public URL of the app, e.g. https://trips.example.com (no domain in code).
APP_URL=http://localhost:3333
# Name used in logs and mails.
APP_NAME=monki-trips
# Empty = read from the image (.app-version / .git-sha written at build time).
APP_VERSION=
GIT_SHA=
# Public sign-up. Open it to create the first user, then close it; invited
# people can still sign up while it is closed.
REGISTRATION_OPEN=false
# Locale when Accept-Language names no supported one: en | es (default en).
APP_DEFAULT_LOCALE=en
# Which proxy's client-address header to believe for throttles: none | cloudflare.
# none (default) keys throttles on the socket address and ignores
# CF-Connecting-IP, which anyone can send. Set cloudflare only when the
# origin accepts traffic from Cloudflare alone (tunnel or firewall).
TRUSTED_PROXY=none

#--------------------------------------------------------------------
# Session: cookie (encrypted cookie store, production) | memory (tests)
#--------------------------------------------------------------------
SESSION_DRIVER=cookie

#--------------------------------------------------------------------
# Database (Postgres 17). compose.dev.yaml publishes it on 127.0.0.1:5432.
#--------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=monkitrips
# Secret in production.
DB_PASSWORD=monkitrips
DB_DATABASE=monkitrips
# Connection pool size per process (default 10).
DB_POOL_MAX=10

#--------------------------------------------------------------------
# Object storage for documents: fs (local disk, tests only) | s3 (any
# S3-compatible store; MinIO locally with `--profile s3`, see compose.dev.yaml).
# With DRIVE_DISK=fs the S3_* values may stay empty; DRIVE_DISK=s3 makes all
# five required (boot fails otherwise). S3_KEY and S3_SECRET are secrets.
#--------------------------------------------------------------------
DRIVE_DISK=fs
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_KEY=
S3_SECRET=

#--------------------------------------------------------------------
# LLM behind an Anthropic Messages compatible adapter: fake | anthropic | openai.
# `fake` answers from test fixtures only (production answers 503 with it);
# `anthropic` is any Anthropic Messages compatible endpoint (Anthropic itself,
# MiniMax's compatible endpoint) and requires LLM_API_KEY and LLM_MODEL (boot
# fails otherwise); `openai` is a reserved seam that answers 503 until it is
# written. LLM_API_KEY is a secret.
# LLM_BASE_URL: the endpoint's origin without the `/v1/messages` path; empty =
#   Anthropic's default (config/llm.ts).
# LLM_VISION_MODEL: the model that reads images and scanned PDFs (receipt
#   photos, "Read this booking" on a scan); empty = vision off: those answer
#   503 E_EXTRACTION_UNAVAILABLE and a PDF with a text layer still works
#   through LLM_MODEL.
# LLM_MONTHLY_TOKEN_CAP_OVERRIDE: tokens (input + output) per account and UTC
#   month, replacing the plan caps of config/plans.ts for every account;
#   empty = the plan caps. Over the cap the API answers 402.
#--------------------------------------------------------------------
LLM_PROVIDER=fake
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_VISION_MODEL=
LLM_MONTHLY_TOKEN_CAP_OVERRIDE=

#--------------------------------------------------------------------
# Other external providers (every one has a fake for tests)
#--------------------------------------------------------------------
# Exchange rates: fake | frankfurter
FX_PROVIDER=fake
# Weather on the Today screen: fake | open-meteo | off
WEATHER_PROVIDER=off
# Flight status: fake | off
FLIGHT_STATUS_PROVIDER=off

#--------------------------------------------------------------------
# Mail: log (writes to the log, never sends) | resend.
# MAIL_FROM e.g. "monki trips <noreply@example.com>". `resend` requires
# RESEND_API_KEY and MAIL_FROM; with `log` they may stay empty. RESEND_API_KEY is a secret.
#--------------------------------------------------------------------
MAIL_DRIVER=log
MAIL_FROM=
RESEND_API_KEY=

#--------------------------------------------------------------------
# Web Push (VAPID). Generate a pair once with `node ace vapid:generate` and
# paste the three lines here (or in the hosting panel); never commit real
# keys. All three empty = push disabled (GET /config reports pushEnabled:
# false and the app hides the notifications toggle); setting one makes the
# other two required. VAPID_SUBJECT is a mailto: or https: contact for the
# push services. VAPID_PRIVATE_KEY is a secret. Changing the pair invalidates
# every subscription: people enable notifications again.
#--------------------------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

#--------------------------------------------------------------------
# In-process scheduler (reminders, pruning): on (default) | off. Every
# replica runs it; a Postgres advisory lock plus the scheduler_runs table
# make each job slot run once across them. Set off on a replica that must
# not run jobs (a one-off maintenance container, the test suite).
#--------------------------------------------------------------------
SCHEDULER=on

#--------------------------------------------------------------------
# Deploy-time bootstrap (docker/entrypoint.mjs)
# MIGRATE_ON_START: run `migration:run --force` before the server starts.
# SEED_USERS: create the owner (and optionally a partner) from the SEED_*
#   values on first deploy; afterwards set it to false and clear the
#   passwords. Idempotent by e-mail. Real e-mails live only in the
#   deployment's environment. SEED_LOCALE: en | es. Passwords are secrets.
#--------------------------------------------------------------------
MIGRATE_ON_START=false
SEED_USERS=false
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=
SEED_PARTNER_EMAIL=
SEED_PARTNER_PASSWORD=
SEED_LOCALE=en