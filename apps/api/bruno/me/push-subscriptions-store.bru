meta {
  name: Register a push subscription
  type: http
  seq: 19
}

post {
  url: {{baseUrl}}/api/v1/me/push-subscriptions
  body: json
  auth: none
}

headers {
  X-XSRF-TOKEN: {{xsrfToken}}
}

body:json {
  {
    "endpoint": "https://push.example.com/send/abc",
    "keys": {
      "p256dh": "key",
      "auth": "secret"
    },
    "deviceLabel": "Phone"
  }
}

vars:post-response {
  pushSubscriptionId: res.body.data.id
}
