meta {
  name: Log in
  type: http
  seq: 5
  tags: [
    smoke
  ]
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

headers {
  X-XSRF-TOKEN: {{xsrfToken}}
}

body:json {
  {
    "email": "{{smokeEmail}}",
    "password": "{{smokePassword}}"
  }
}

assert {
  res.status: eq 200
  res.body.data.email: isString
}
