meta {
  name: Sign up
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/auth/signup
  body: json
  auth: none
}

headers {
  X-XSRF-TOKEN: {{xsrfToken}}
}

body:json {
  {
    "email": "newcomer@example.com",
    "password": "a-long-passphrase",
    "displayName": "Newcomer",
    "invitationToken": "{{invitationToken}}"
  }
}
