meta {
  name: Invite someone
  type: http
  seq: 33
}

post {
  url: {{baseUrl}}/api/v1/trips/{{tripId}}/invitations
  body: json
  auth: none
}

headers {
  X-XSRF-TOKEN: {{xsrfToken}}
}

body:json {
  {}
}

docs {
  A link invitation, so the response carries the token the next requests use.
  With { "email": "partner@example.com" } the invitation is mailed instead and
  the response has no token (delivery: email).
}

vars:post-response {
  invitationId: res.body.data.invitation.id
  invitationToken: res.body.data.token
}
