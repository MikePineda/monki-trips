meta {
  name: Delete an assistant conversation
  type: http
  seq: 64
}

delete {
  url: {{baseUrl}}/api/v1/trips/{{tripId}}/ai/conversations/{{conversationId}}
  body: none
  auth: none
}

headers {
  X-XSRF-TOKEN: {{xsrfToken}}
}

docs {
  204. Deletes the conversation with its messages and proposals; what was
  already accepted stays in the trip.
}
