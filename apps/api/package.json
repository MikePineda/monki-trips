{
  "name": "@monkitrips/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "exports": {
    "./data": "./.adonisjs/client/data.d.ts",
    "./registry": "./.adonisjs/client/registry/index.ts"
  },
  "scripts": {
    "start": "node bin/server.js",
    "build": "node ace build",
    "dev": "node ace serve --hmr",
    "codegen": "node ace codegen",
    "test": "node --import=@poppinss/ts-exec --enable-source-maps bin/test.ts",
    "test:watch": "node ace test --watch",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "bruno:coverage": "node scripts/bruno-coverage.mjs"
  },
  "imports": {
    "#controllers/*": "./app/controllers/*.js",
    "#exceptions/*": "./app/exceptions/*.js",
    "#models/*": "./app/models/*.js",
    "#services/*": "./app/services/*.js",
    "#domain/*": "./app/domain/*.js",
    "#generated/*": "./.adonisjs/server/*.js",
    "#middleware/*": "./app/middleware/*.js",
    "#transformers/*": "./app/transformers/*.js",
    "#validators/*": "./app/validators/*.js",
    "#providers/*": "./providers/*.js",
    "#database/*": "./database/*.js",
    "#tests/*": "./tests/*.js",
    "#start/*": "./start/*.js",
    "#config/*": "./config/*.js"
  },
  "devDependencies": {
    "@adonisjs/assembler": "8.6.0",
    "@adonisjs/eslint-config": "3.1.0",
    "@adonisjs/prettier-config": "1.5.0",
    "@adonisjs/tsconfig": "2.0.0",
    "@japa/api-client": "3.2.1",
    "@japa/assert": "4.2.0",
    "@japa/plugin-adonisjs": "5.2.0",
    "@japa/runner": "5.4.0",
    "@poppinss/ts-exec": "1.5.2",
    "@types/luxon": "3.7.6",
    "@types/node": "~24.19.2",
    "@types/pg": "8.23.1",
    "eslint": "10.14.0",
    "hot-hook": "1.0.0",
    "pino-pretty": "13.2.0",
    "prettier": "3.9.10",
    "typescript": "~6.0.3",
    "youch": "4.1.1"
  },
  "dependencies": {
    "@adonisjs/auth": "10.1.0",
    "@adonisjs/core": "7.6.0",
    "@adonisjs/cors": "3.0.0",
    "@adonisjs/i18n": "3.0.1",
    "@adonisjs/limiter": "3.0.1",
    "@adonisjs/lucid": "22.4.2",
    "@adonisjs/session": "8.3.0",
    "@adonisjs/shield": "9.0.0",
    "@adonisjs/static": "2.0.1",
    "@monkitrips/shared": "*",
    "@tuyau/core": "1.3.0",
    "@vinejs/vine": "4.4.0",
    "luxon": "3.7.2",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2"
  },
  "hotHook": {
    "boundaries": [
      "./app/controllers/**/*.ts",
      "./app/middleware/*.ts"
    ]
  },
  "prettier": "@adonisjs/prettier-config"
}
