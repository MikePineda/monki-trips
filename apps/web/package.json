    "@angular/router": "22.2.5",
    "@angular/service-worker": "22.2.5",
    "@jsverse/transloco": "8.4.0",
    "@monkitrips/shared": "*",
    "@tuyau/core": "1.3.0",
    "rxjs": "7.8.2",
    "tslib": "2.9.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.6",
    "@angular/cli": "22.2.6",
    "@angular/compiler-cli": "22.2.5",
    "@eslint/js": "10.0.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "~24.19.2",
    "angular-eslint": "22.6.0",
    "eslint": "10.14.0",
    "jsdom": "31.0.0",
    "postcss": "8.5.32",
    "prettier": "3.9.10",
